# Model for libdeviceinfo
ro.product.vendor.device=degas
# Camera model for taken pictures
ro.product.model=Xiaomi 14T
# MTP device name
ro.product.vendor.model=Xiaomi 14T
# Manufacturer in host dmesg
ro.product.vendor.manufacturer=Xiaomi
# Use Mali GLES directly instead of the MediaTek MEOW wrapper (stock: meow)
ro.hardware.egl=mali

# Modem NV / IMEI signature product string. The modem's secure NV check
# (custom_nvram_check_signed_critical_data -> custom_nvram_get_product in
# modem.img) reads ro.product.vendor.name and ccci_rpcd answers the modem's
# IPC_RPC_QUERY_AP_SYS_PROPERTY<ro.product.vendor.name>. The device's signed
# critical data (cpuid + IMEI1 + IMEI2 in nvdata NVD_IMEI/CSSD_000) was signed
# against the stock product string, which HyperOS loads from the opcust
# partition (opcust/etc/carrier.prop, whitelisted in carrier_prop_white_keys_list)
# and which differs from the plain vendor build.prop value (degas_global).
# Halium has no Xiaomi init_hook to apply that overlay, so the modem saw
# degas_global, its legitimate IMEI signature failed to verify (+ENVSIGERR,
# vendor.ril.imei.check=fail) and it refused to switch the radio on. Pin the
# genuine stock value so the signed IMEI verifies exactly as on HyperOS.
ro.product.vendor.name=a81489edf3camellian

# MediaTek runtime switchable config (RSC) for this phone's region. The
# bootloader passes androidboot.rsc=GL; HyperOS init then loads
# /vendor/etc/rsc/GL/ro.prop, the Halium init does not. Without it the vendor
# defaults (CN: modem type 25 with C2K) apply, the modem boots the wrong
# profile, rejects the IMEI signature (+ENVSIGERR, vendor.ril.imei.check=fail)
# and refuses to switch the radio on. Values from /vendor/etc/rsc/GL/ro.prop.
ro.vendor.mtk_protocol1_rat_config=N/Lf/Lt/W/G
ro.vendor.mtk_c2k_lte_mode=0
ro.vendor.mtk_md1_support=22
ro.vendor.mtk_md3_support=0
ro.vendor.mtk_eccci_c2k=1
ro.vendor.mtk_ps1_rat=N/Lf/Lt/W/G
ro.vendor.mtk_lte_support=1
ro.vendor.mtk_c2k_support=0
ro.telephony.default_network=32,32,32,32
ro.vendor.mediatek.rsc_name=GL
ro.vendor.sys.current_rsc_path=/system/etc/rsc/GL
ro.vendor.vnd.current_rsc_path=/vendor/etc/rsc/GL
